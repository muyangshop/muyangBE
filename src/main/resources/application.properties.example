spring.application.name=muyang-server

# 앱(muyang-app)이 3000 포트를 바라보므로 동일하게 설정
server.port=3000

# 인메모리 H2 — 서버 재시작 시 초기화, DataSeeder가 데모 데이터 적재
spring.datasource.url=jdbc:h2:mem:muyang
spring.jpa.hibernate.ddl-auto=create-drop
spring.h2.console.enabled=true

# 관리자 페이지(Thymeleaf) — 개발 중 템플릿 캐시 끄기
spring.thymeleaf.cache=false

# JWT — HS256, 32자 이상. 실제 운영 값으로 교체
app.jwt.secret=CHANGE_ME_TO_A_RANDOM_32+_CHAR_SECRET
app.jwt.expiration-ms=86400000

# ── 결제 (실제 키로 교체) ──
payment.toss.base-url=https://api.tosspayments.com
payment.toss.secret-key=test_sk_XXXXXXXXXXXXXXXXXXXX

payment.kakao.base-url=https://open-api.kakaopay.com
payment.kakao.secret-key=
payment.kakao.cid=TC0ONETIME

payment.naver.base-url=https://dev.apis.naver.com
payment.naver.client-id=NAVER_CLIENT_ID
payment.naver.client-secret=NAVER_CLIENT_SECRET
payment.naver.chain-id=CHAIN_ID

# ── 카카오 로그인 (카카오 개발자센터 발급 값으로 교체) ──
kakao.rest-api-key=YOUR_KAKAO_REST_API_KEY
kakao.client-secret=YOUR_KAKAO_CLIENT_SECRET
kakao.redirect-uri=

# ※ 이 파일을 application.properties 로 복사한 뒤 실제 값을 채우세요.
#    application.properties 는 .gitignore 로 제외되어 커밋되지 않습니다.
